{
  "version": 6,
  "configurePresets": [
    {
      "name": "win-x64",
      "displayName": "Windows x64 (Ninja, MSVC, vcpkg)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/win-x64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "win-x64", "configuration": "Debug" },
    { "name": "release", "configurePreset": "win-x64", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "win-x64", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
